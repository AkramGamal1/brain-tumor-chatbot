# Required — get a free key from https://console.groq.com/keys
# (Free tier: generous request budget on llama-3.3-70b-versatile, no credit card required.)
GROQ_API_KEY=

# ML service
ML_API_BASE_URL=http://localhost:8000

# Model
GROQ_MODEL=llama-3.3-70b-versatile

# Image sanity-check thresholds (tunable)
IMAGE_SATURATION_THRESHOLD=0.15
IMAGE_ASPECT_RATIO_MAX=2.0

# Confidence-band thresholds (tunable)
BAND_HIGH=0.85
BAND_LOW=0.65

# Glioma↔meningioma overlap rule
GLIOMA_MENINGIOMA_GAP=0.20

# Server
CHATBOT_PORT=8001
