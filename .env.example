# Required - get a free key from https://aistudio.google.com/app/apikey
# (Free tier on gemini-2.5-flash; no credit card required.)
GOOGLE_API_KEY=

# ML service
ML_API_BASE_URL=http://localhost:8000

# Model
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

RETRIEVER_TOP_K=2

# Image sanity-check thresholds (tunable)
IMAGE_SATURATION_THRESHOLD=0.15
IMAGE_ASPECT_RATIO_MAX=2.0

# Confidence-band thresholds (tunable)
BAND_HIGH=0.85
BAND_LOW=0.65

# Glioma↔meningioma overlap rule
GLIOMA_MENINGIOMA_GAP=0.20

# Server
CHATBOT_PORT=8001

# UI & CORS (added for API mode)
SERVE_DEMO_UI=false
CORS_ORIGINS=*
